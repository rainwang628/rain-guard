{
  "whitelist": [
    "agents.md",
    "config",
    "hosts",
    "memory",
    "projs",
    "softs",
    "teams",
    "tmp",
    "reports"
  ],
  "homeWhitelist": [
    "Applications",
    "Desktop",
    "Documents",
    "Downloads",
    "Library",
    "Movies",
    "Music",
    "Pictures",
    "Public",
    "jiaojiao",
    "rain"
  ],
  "stagingDirs": {
    "dirs": [
      "~/rain/tmp/inbox"
    ],
    "graceHours": 24,
    "ignore": [
      ".DS_Store",
      ".localized"
    ]
  },
  "notifyScript": "~/rain/projs/services/gw-push-gateway/notify",
  "launchdAgents": {
    "dir": "~/Library/LaunchAgents",
    "expected": {
      "com.rain.apiwatch.gateway": "present",
      "com.rain.apiwatch.watchd": "present",
      "com.rain.qianji-readonly.upstream": "run",
      "com.rain.guard": "loaded",
      "com.rain.structure-snapshot": "loaded"
    }
  },
  "launchdDaemons": {
    "dir": "/Library/LaunchDaemons",
    "expected": {}
  },
  "formalProjects": {
    "enabled": true,
    "dir": "~/rain/projs/apps",
    "staleDays": 3,
    "ignore": []
  },
  "racingProjects": {
    "enabled": true,
    "dir": "~/rain/projs/racing",
    "staleDays": 30,
    "activeDays": 7
  },
  "patchProjects": {
    "enabled": true,
    "dir": "~/rain/projs/patches",
    "staleDays": 60
  },
  "labProjects": {
    "enabled": true,
    "dir": "~/rain/projs/lab",
    "staleDays": 60
  },
  "upstreamProjects": {
    "enabled": true,
    "dir": "~/rain/projs/upstream",
    "staleDays": 90
  },
  "archiveProjects": {
    "enabled": true,
    "dir": "~/rain/projs/archive"
  },
  "unregisteredProjects": {
    "enabled": true,
    "registry": [
      "apps",
      "racing",
      "patches",
      "services",
      "upstream",
      "lab",
      "archive",
      "agent-rules"
    ]
  }
}