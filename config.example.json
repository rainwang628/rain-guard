{
  "whitelist": ["agents.md", "hosts", "lab", "memory", "projs", "softs", "tmp"],
  "homeWhitelist": ["Applications", "Desktop", "Documents", "Downloads", "Library", "Movies", "Music", "Pictures", "Public", "jiaojiao", "rain"],
  "stagingDirs": {
    "dirs": ["~/rain/tmp/inbox"],
    "graceHours": 24,
    "ignore": [".DS_Store", ".localized"]
  },
  "pushplusConfigPath": "~/rain/projs/services/aa-notify/config.json",
  "pushplusToken": "",
  "launchdAgents": {
    "dir": "~/Library/LaunchAgents",
    "expected": {
      "com.rain.aa-notify": "run"
    }
  },
  "launchdDaemons": {
    "dir": "/Library/LaunchDaemons",
    "expected": {}
  },
  "formalProjects": {
    "enabled": true,
    "dir": "~/rain/projs/apps",
    "staleDays": 3
  },
  "racingProjects": {
    "enabled": true,
    "dir": "~/rain/projs/racing",
    "staleDays": 30,
    "activeDays": 7
  },
  "patchProjects": {
    "enabled": true,
    "dir": "~/rain/projs/patches",
    "staleDays": 60
  }
}
