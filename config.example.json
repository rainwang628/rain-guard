{
  "whitelist": ["agents.md", "config", "hosts", "memory", "projs", "softs", "tmp"],
  "homeWhitelist": ["Applications", "Desktop", "Documents", "Downloads", "Library", "Movies", "Music", "Pictures", "Public", "jiaojiao", "rain"],
  "stagingDirs": {
    "dirs": ["~/rain/tmp/inbox"],
    "graceHours": 24,
    "ignore": [".DS_Store", ".localized"]
  },
  "notifyScript": "~/rain/projs/services/push-gateway/notify",
  "launchdAgents": {
    "dir": "~/Library/LaunchAgents",
    "expected": {
      "com.rain.aa-notify": "run",
      "com.rain.apiwatch.gateway": "run",
      "com.rain.apiwatch.watchd": "run",
      "com.rain.qianji-readonly.tunnel": "run",
      "com.rain.qianji-readonly.upstream": "run",
      "com.rain.guard": "loaded",
      "com.rain.structure-snapshot": "loaded"
    }
  },
  "launchdDaemons": {
    "dir": "/Library/LaunchDaemons",
    "expected": {}
  },
  "formalProjects": {
    "enabled": true,
    "dir": "~/rain/projs/apps",
    "staleDays": 3
  },
  "racingProjects": {
    "enabled": true,
    "dir": "~/rain/projs/racing",
    "staleDays": 30,
    "activeDays": 7
  },
  "patchProjects": {
    "enabled": true,
    "dir": "~/rain/projs/patches",
    "staleDays": 60
  }
}
